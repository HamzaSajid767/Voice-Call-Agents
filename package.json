{
  "name": "aktivecycle-backend",
  "version": "1.0.0",
  "description": "Backend API for AktiveCycle cycling tours discovery app",
  "main": "src/server.js",
  "scripts": {
    "start": "pm2 start ecosystem.config.cjs",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "migrate:mongo-to-postgres": "node scripts/migrate-mongo-to-postgres.js",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:api": "node scripts/test-api.js",
    "prepare": "node scripts/husky-prepare.cjs",
    "format": "prettier \"src/**/*.{js,json}\" --write",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:prod": "pm2 start ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 restart leadsgetter-backend",
    "pm2:stop": "pm2 stop leadsgetter-backend",
    "pm2:delete": "pm2 delete leadsgetter-backend",
    "pm2:logs": "pm2 logs leadsgetter-backend",
    "pm2:save": "pm2 save",
    "dev:ts": "tsx watch src/server.ts",
    "build:ts": "tsc -p tsconfig.json",
    "start:ts": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "system:test": "tsx src/tests/system-test.ts",
    "load:test": "tsx src/tests/load-test.ts",
    "e2e:test": "tsx src/tests/e2e-runner.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@livekit/rtc-node": "^0.13.25",
    "@prisma/client": "^6.19.0",
    "@supabase/supabase-js": "^2.103.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dayjs": "^1.11.19",
    "dotenv": "^17.3.1",
    "ejs": "^5.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.15.1",
    "morgan": "^1.10.1",
    "multer": "^2.1.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.3",
    "stripe": "^17.7.0",
    "twilio": "^6.0.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "autocannon": "^8.0.0",
    "cross-env": "^7.0.3",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.3.2",
    "mongodb": "^6.21.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "prisma": "^6.19.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "src/**/*.{js,json}": [
      "prettier --write"
    ]
  }
}
